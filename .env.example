# Copy this file to .env and fill in real values. Never commit .env.
#
# See README.md "Production setup" for exact steps (Supabase connection
# string format, Groq key, Vercel env vars, cron-job.org config) and
# SETUP_TODO.md for what specifically needs to be plugged in for a real
# deployment.

# Postgres connection string (Supabase-compatible). Use the "Connection
# pooling" string (port 6543, ?pgbouncer=true) for serverless deploys like
# Vercel; the direct string (port 5432) works for local dev / long-lived
# processes. URL-encode any special characters in the password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Groq API key (https://console.groq.com/keys). If unset or MOCK_MODE=true,
# lib/generation.ts returns realistic placeholder text instead of calling
# the Groq API, so the full discover -> judge -> write -> publish cycle can
# be exercised end-to-end with zero external dependencies.
GROQ_API_KEY=""
MOCK_MODE="true"

# Shared secret required in the `x-cron-secret` header on
# POST /api/agent/cycle. Generate with: openssl rand -hex 24
CRON_SECRET=""

# Minimum hours between autonomous cycles. Drives the frontend's
# "time until next cycle" indicator.
CYCLE_INTERVAL_HOURS="4"
